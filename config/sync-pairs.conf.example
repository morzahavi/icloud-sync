# One local source folder per line.
# Destination is computed as:
#   $SYNC_ICLOUD_ROOT/<path relative to $HOME>
#
# Default source configured by scripts/install-launchagents:
#   ~/projects/icloud-sync-demo/
#
# The example above maps to:
#   ~/icloud/projects/icloud-sync-demo/

# First install writes the demo source above as the only active sync source.
# Add real project folders only after reviewing their .icloud-sync-filter files.
