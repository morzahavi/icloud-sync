# One local source folder per line.
# Destination is computed as:
#   $SYNC_ICLOUD_ROOT/<path relative to $HOME>
#
# Default option offered by scripts/configure-sync-sources:
#   ~/projects/
#
# The example above maps to:
#   ~/icloud/projects/

# This file starts with no active sources. Run:
#   ./scripts/configure-sync-sources
