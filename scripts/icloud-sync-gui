    }
    header {
      padding: 20px 24px 12px;
      border-bottom: 1px solid var(--border);
    }
    h1 { margin: 0 0 4px; font-size: 24px; }
    h2 { margin: 0 0 10px; font-size: 16px; }
    main {
      display: grid;
      gap: 16px;
      padding: 16px 24px 24px;
    }
    section {
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 14px;
    }
    table {
      width: 100%;
      border-collapse: collapse;
    }
    th, td {
      text-align: left;
      border-bottom: 1px solid var(--border);
      padding: 8px;
      vertical-align: top;
    }
    th { color: var(--muted); font-weight: 600; }
    .critical th {
      width: 260px;
      color: var(--text);
    }
    .status-grid {
      display: grid;
      grid-template-columns: minmax(360px, 0.8fr) minmax(520px, 1.2fr);
      gap: 18px;
      align-items: start;
    }
    .status-times { grid-column: 1; }
    .status-info { grid-column: 2; }
    .status-grid h3 {
      margin: 0 0 8px;
      font-size: 14px;
      color: var(--muted);
    }
    .status-grid th {
      width: 220px;
    }
    .status-times th {
      width: 240px;
    }
    .raw-duration {
      width: 88px;
      text-align: right;
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
    }
    .readable-duration {
      width: 160px;
      white-space: nowrap;
    }
    @media (max-width: 820px) {
      .status-grid {
        grid-template-columns: 1fr;
      }
      .status-times,
      .status-info {
        grid-column: 1;
      }
    }
    code, pre {
      font-family: Menlo, Consolas, monospace;
      font-size: 12px;
    }
    code {
      background: var(--code);
      padding: 2px 4px;
      border-radius: 4px;
    }
    pre {
      overflow: auto;
      white-space: pre-wrap;
      margin: 0;
      padding: 12px;
      background: var(--code);
      border-radius: 6px;
      max-height: 360px;
    }
    .muted { color: var(--muted); }
    .commands {
      display: grid;
      grid-template-columns: repeat(3, minmax(220px, 1fr));
      gap: 10px;
      margin-top: 10px;
    }
    .command h3 {
      margin: 0 0 6px;
      font-size: 13px;
      color: var(--muted);
    }
    .automation-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(260px, 1fr));
      gap: 12px;
    }
    .automation-action {
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 12px;
    }
    .automation-action h3 {
      margin: 0 0 8px;
      font-size: 14px;
    }
    @media (max-width: 820px) {
      .automation-grid {
        grid-template-columns: 1fr;
      }
      .commands {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>
  <header>
    <h1>iCloud Sync Status</h1>
    <div class="muted">Generated $generated_at. This page refreshes every 30 seconds.</div>
    <div class="commands">
      <div class="command">
        <h3>Edit Source Config</h3>
        <pre>\$EDITOR "$SYNC_PAIRS_FILE"</pre>
      </div>
      <div class="command">
        <h3>Show Sync Log</h3>
        <pre>cat "$SYNC_LOG"</pre>
      </div>
      <div class="command">
        <h3>Show Health Log</h3>
        <pre>cat "$HEALTH_LOG"</pre>
      </div>
    </div>
  </header>
  <main>
    <section>
      <h2>Automation Controls</h2>
      <div class="automation-grid">
        <div class="automation-action">
          <h3>Abort Automation</h3>
          <div class="muted">Stops both LaunchAgents but keeps config, logs, and plist files.</div>
          <pre>cd "$REPO_ROOT"
./scripts/abort-automation</pre>
        </div>
        <div class="automation-action">
          <h3>Start Automation</h3>
          <div class="muted">Loads both existing LaunchAgent plist files and kickstarts them.</div>
          <pre>cd "$REPO_ROOT"
./scripts/start-automation</pre>
        </div>
      </div>
    </section>
    <section class="critical">
      <h2>Critical Notifications</h2>
      <table>
        <tbody>
HTML
  critical_rows
  cat <<HTML
        </tbody>
      </table>
    </section>
    <section>
      <h2>Configured Mappings</h2>
      <table>
        <thead><tr><th>Local source</th><th>iCloud destination</th><th>Filter file</th></tr></thead>
        <tbody>
HTML
  source_rows
  cat <<HTML
        </tbody>
      </table>
    </section>
    <section>
      <h2>Status</h2>
      <div class="status-grid">
        <div class="status-times">
          <h3>Configured Times</h3>
          <table>
            <tbody>
              $(duration_row "Sync interval" "$SYNC_INTERVAL_SECONDS")
              $(duration_row "Stale after" "$SYNC_STALE_AFTER_SECONDS")
              $(duration_row "Max run warning" "$SYNC_MAX_RUN_SECONDS")
            </tbody>
          </table>
        </div>
        <div class="status-info">
          <h3>Paths and Other Info</h3>
          <table>
            <tbody>
              $(code_row "Config file" "$CONFIG_FILE")
              $(code_row "Source config" "$SYNC_PAIRS_FILE")
              $(code_row "iCloud root" "$(normalize_dir "$SYNC_ICLOUD_ROOT")")
              $(code_row "Sync log" "$SYNC_LOG")
              $(code_row "Health log" "$HEALTH_LOG")
              $(code_row "State dir" "$SYNC_STATE_DIR")
              $(value_row "Filter file name" "$SYNC_FILTER_FILE_NAME")
              $(value_row "Delete destination" "$SYNC_DELETE_DESTINATION")
              $(value_row "Skip on low battery" "$SYNC_SKIP_ON_LOW_BATTERY")
              $(value_row "Min battery" "${SYNC_MIN_BATTERY_PERCENT}%")
              $(value_row "Local free" "$(free_mb_for_path "$HOME") MB (required ${SYNC_MIN_FREE_LOCAL_MB} MB)")
              $(value_row "iCloud target free" "$(free_mb_for_path "$SYNC_ICLOUD_ROOT") MB (required ${SYNC_MIN_FREE_ICLOUD_MB} MB)")
              $(value_row "Last successful sync" "$(last_successful_sync)")
              $(value_row "Sync agent" "dev.icloud-sync: $(agent_status_detail dev.icloud-sync)")
              $(value_row "Health agent" "dev.icloud-sync.health: $(agent_status_detail dev.icloud-sync.health)")
            </tbody>
          </table>
        </div>
      </div>
    </section>
    <section>
      <h2>Sync Log</h2>
      <div class="muted">Newest runs are shown first.</div>
      <pre>$(printf '%s' "$sync_log_output" | html_escape)</pre>
    </section>
    <section>
      <h2>Health Log</h2>
      <div class="muted">Newest entries are shown first.</div>
      <pre>$(printf '%s' "$health_log_output" | html_escape)</pre>
    </section>
  </main>
</body>
</html>
HTML
} > "$DASHBOARD_FILE"

if [[ "${ICLOUD_SYNC_GUI_OPEN:-1}" == "0" ]]; then
  echo "Generated $DASHBOARD_FILE"
else
  open "$DASHBOARD_FILE"
  echo "Opened $DASHBOARD_FILE"
fi
