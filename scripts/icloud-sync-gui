#!/bin/zsh

set -e
set -u
set -o pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
source "$SCRIPT_DIR/lib/icloud-sync-config"

DASHBOARD_DIR="$SYNC_STATE_DIR/gui"
DASHBOARD_FILE="$DASHBOARD_DIR/status.html"
SYNC_LOG="$SYNC_LOG_DIR/sync.log"
HEALTH_LOG="$SYNC_LOG_DIR/sync-health.log"
LAUNCH_AGENTS_DIR="$HOME/Library/LaunchAgents"

mkdir -p "$DASHBOARD_DIR"

html_escape() {
  sed \
    -e 's/&/\&amp;/g' \
    -e 's/</\&lt;/g' \
    -e 's/>/\&gt;/g'
}

file_tail() {
  local file_path="$1"
  local lines="${2:-80}"

  if [[ -f "$file_path" ]]; then
    tail -n "$lines" "$file_path"
  else
    echo "$file_path does not exist yet."
  fi
}

file_head() {
  local file_path="$1"
  local lines="${2:-80}"

  if [[ -f "$file_path" ]]; then
    head -n "$lines" "$file_path"
  else
    echo "$file_path does not exist yet."
  fi
}

file_tail_newest_first() {
  local file_path="$1"
  local lines="${2:-80}"

  if [[ -f "$file_path" ]]; then
    tail -n "$lines" "$file_path" | sed '1!G;h;$!d'
  else
    echo "$file_path does not exist yet."
  fi
}

human_duration() {
  local seconds="$1"
  local days hours minutes remainder
  local parts=()

  if (( seconds < 60 )); then
    echo "${seconds} seconds"
    return
  fi

  days=$(( seconds / 86400 ))
  remainder=$(( seconds % 86400 ))
  hours=$(( remainder / 3600 ))
  remainder=$(( remainder % 3600 ))
  minutes=$(( remainder / 60 ))
  remainder=$(( remainder % 60 ))

  (( days > 0 )) && parts+=("${days} day$([[ "$days" == 1 ]] || echo s)")
  (( hours > 0 )) && parts+=("${hours} hour$([[ "$hours" == 1 ]] || echo s)")
  (( minutes > 0 )) && parts+=("${minutes} minute$([[ "$minutes" == 1 ]] || echo s)")
  (( remainder > 0 )) && parts+=("${remainder} second$([[ "$remainder" == 1 ]] || echo s)")

  echo "${(j:, :)parts}"
}

agent_status() {
  local label="$1"
  local domain="gui/$(id -u)"

  if launchctl print "$domain/$label" >/dev/null 2>&1; then
    echo "loaded"
  else
    echo "not loaded"
  fi
}

agent_script_name() {
  case "$1" in
    dev.icloud-sync) echo "sync-to-icloud" ;;
    dev.icloud-sync.health) echo "check-sync-health" ;;
  esac
}

agent_program() {
  local label="$1"
  local plist="$LAUNCH_AGENTS_DIR/$label.plist"

  [[ ! -f "$plist" ]] && return 1
  plutil -extract ProgramArguments.2 raw -o - "$plist" 2>/dev/null
}

expected_agent_program() {
  local label="$1"
  local script_name

  script_name="$(agent_script_name "$label")"
  echo "exec \"$SCRIPT_DIR/$script_name\""
}

agent_matches_checkout() {
  local label="$1"
  local program

  program="$(agent_program "$label" 2>/dev/null || true)"
  [[ -n "$program" && "$program" == "$(expected_agent_program "$label")" ]]
}

agent_status_detail() {
  local label="$1"
  local current_status

  current_status="$(agent_status "$label")"
  if agent_matches_checkout "$label"; then
    echo "$current_status; matches this checkout"
  elif agent_program "$label" >/dev/null 2>&1; then
    echo "$current_status; plist points elsewhere"
  else
    echo "$current_status; plist missing"
  fi
}

last_successful_sync() {
  local last_run_file="$SYNC_STATE_DIR/sync.last-run"

  if [[ -f "$last_run_file" ]]; then
    cat "$last_run_file"
  else
    echo "never"
  fi
}

last_success_age_seconds() {
  local last_run_file="$SYNC_STATE_DIR/sync.last-run"

  if [[ -f "$last_run_file" ]]; then
    echo $(( $(date +%s) - $(stat -f %m "$last_run_file") ))
  else
    echo ""
  fi
}

value_row() {
  local label="$1"
  local value="$2"

  printf '<tr><th>%s</th><td>%s</td></tr>\n' \
    "$(printf '%s' "$label" | html_escape)" \
    "$(printf '%s' "$value" | html_escape)"
}

duration_row() {
  local label="$1"
  local seconds="$2"

  printf '<tr><th>%s</th><td class="raw-duration">%ss</td><td class="readable-duration">(%s)</td></tr>\n' \
    "$(printf '%s' "$label" | html_escape)" \
    "$(printf '%s' "$seconds" | html_escape)" \
    "$(human_duration "$seconds" | html_escape)"
}

code_row() {
  local label="$1"
  local value="$2"

  printf '<tr><th>%s</th><td><code>%s</code></td></tr>\n' \
    "$(printf '%s' "$label" | html_escape)" \
    "$(printf '%s' "$value" | html_escape)"
}

source_rows() {
  local source_dir
  local destination_dir
  local filter_file

  if ! has_sync_sources; then
    echo '<tr><td colspan="3">No source folders configured.</td></tr>'
    return
  fi

  while IFS= read -r source_dir; do
    if reject_source_path "$source_dir" >/dev/null 2>&1; then
      destination_dir="$(destination_for_source "$source_dir")"
      filter_file="$(filter_file_for_source "$source_dir")"
      printf '<tr><td><code>%s</code></td><td><code>%s</code></td><td><code>%s</code></td></tr>\n' \
        "$(printf '%s' "$source_dir" | html_escape)" \
        "$(printf '%s' "$destination_dir" | html_escape)" \
        "$(printf '%s' "$filter_file" | html_escape)"
    else
      printf '<tr><td><code>%s</code></td><td colspan="2">Rejected: source is outside HOME</td></tr>\n' \
        "$(printf '%s' "$source_dir" | html_escape)"
    fi
  done < <(iter_sync_sources)
}

critical_rows() {
  local count=0
  local source_dir
  local age_seconds
  local local_free_mb
  local icloud_free_mb
  local sync_agent
  local health_agent

  add_critical() {
    local title="$1"
    local detail="$2"

    count=$((count + 1))
    printf '<tr><th>%s</th><td>%s</td></tr>\n' \
      "$(printf '%s' "$title" | html_escape)" \
      "$(printf '%s' "$detail" | html_escape)"
  }

  if ! has_sync_sources; then
    add_critical "No sources configured" "Choose at least one local source folder before relying on automation."
  fi

  while IFS= read -r source_dir; do
    if ! reject_source_path "$source_dir" >/dev/null 2>&1; then
      add_critical "Rejected source" "$source_dir is outside HOME and will not sync."
    elif [[ ! -d "$source_dir" ]]; then
      add_critical "Missing source" "$source_dir does not exist."
    elif [[ -d "${source_dir}.git" ]]; then
      add_critical "Repository source" "$source_dir is a Git repo. icloud-sync will mirror the whole repo directory unless its $(filter_file_for_source "$source_dir") file excludes paths."
    fi
  done < <(iter_sync_sources)

  local_free_mb="$(free_mb_for_path "$HOME")"
  if (( local_free_mb < SYNC_MIN_FREE_LOCAL_MB )); then
    add_critical "Low local storage" "${local_free_mb} MB free; required ${SYNC_MIN_FREE_LOCAL_MB} MB."
  fi

  icloud_free_mb="$(free_mb_for_path "$SYNC_ICLOUD_ROOT")"
  if (( icloud_free_mb < SYNC_MIN_FREE_ICLOUD_MB )); then
    add_critical "Low iCloud target storage" "${icloud_free_mb} MB free; required ${SYNC_MIN_FREE_ICLOUD_MB} MB."
  fi

  age_seconds="$(last_success_age_seconds)"
  if [[ -z "$age_seconds" ]]; then
    add_critical "No successful sync yet" "Run scripts/sync-to-icloud after configuring sources."
  elif (( age_seconds > SYNC_STALE_AFTER_SECONDS )); then
    add_critical "Stale successful sync" "Last success was $(human_duration "$age_seconds") ago; threshold is $(human_duration "$SYNC_STALE_AFTER_SECONDS")."
  fi

  sync_agent="$(agent_status dev.icloud-sync)"
  if [[ "$sync_agent" != "loaded" ]]; then
    add_critical "Sync automation not loaded" "LaunchAgent dev.icloud-sync is $sync_agent."
  elif ! agent_matches_checkout dev.icloud-sync; then
    add_critical "Sync automation path mismatch" "LaunchAgent dev.icloud-sync does not point to this checkout. Current program: $(agent_program dev.icloud-sync 2>/dev/null || echo missing)."
  fi

  health_agent="$(agent_status dev.icloud-sync.health)"
  if [[ "$health_agent" != "loaded" ]]; then
    add_critical "Health automation not loaded" "LaunchAgent dev.icloud-sync.health is $health_agent."
  elif ! agent_matches_checkout dev.icloud-sync.health; then
    add_critical "Health automation path mismatch" "LaunchAgent dev.icloud-sync.health does not point to this checkout. Current program: $(agent_program dev.icloud-sync.health 2>/dev/null || echo missing)."
  fi

  if (( count == 0 )); then
    echo '<tr><td colspan="2">No critical notifications.</td></tr>'
  fi
}

sync_log_output="$(file_head "$SYNC_LOG" 120)"
health_log_output="$(file_tail_newest_first "$HEALTH_LOG" 120)"
generated_at="$(date -Iseconds)"

{
  cat <<HTML
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="refresh" content="30">
  <title>iCloud Sync Status</title>
  <style>
    :root {
      color-scheme: light dark;
      --bg: #f7f7f5;
      --panel: #ffffff;
      --text: #202124;
      --muted: #5f6368;
      --border: #d7d9dc;
      --accent: #176b87;
      --code: #f1f3f4;
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --bg: #191a1c;
        --panel: #232528;
        --text: #f1f3f4;
        --muted: #bdc1c6;
        --border: #3c4043;
        --accent: #8ab4f8;
        --code: #303134;
      }
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
