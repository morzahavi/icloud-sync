#!/bin/zsh

set -e
set -u
set -o pipefail

SRC="$HOME/projects/demo/"
DST="$HOME/icloud/projects/demo/"
LOG_DIR="$HOME/.local/share/icloud-sync/logs"
LOG_FILE="$LOG_DIR/demo-sync.log"
STATE_DIR="$HOME/.local/share/icloud-sync/state"
LAST_RUN_FILE="$STATE_DIR/demo-sync.last-run"
LOCK_DIR="/tmp/icloud-sync-demo.lock"
MAX_LOG_BYTES=$((1024 * 1024))
MAX_ROTATED_LOGS=3
MIN_BATTERY_PERCENT="${ICLOUD_SYNC_MIN_BATTERY_PERCENT:-30}"
MAX_RUN_SECONDS="${ICLOUD_SYNC_MAX_RUN_SECONDS:-60}"
ALERT_MODE="${ICLOUD_SYNC_ALERT_MODE:-notification}"

mkdir -p "$DST" "$LOG_DIR" "$STATE_DIR"
date -Iseconds > "$LAST_RUN_FILE"

log_size_bytes() {
  wc -c < "$LOG_FILE" | tr -d '[:space:]'
}

rotate_log_if_needed() {
  local index

  if [[ ! -f "$LOG_FILE" ]]; then
    return
  fi

  if (( $(log_size_bytes) <= MAX_LOG_BYTES )); then
    return
  fi

  rm -f "$LOG_FILE.$MAX_ROTATED_LOGS"
  for (( index = MAX_ROTATED_LOGS - 1; index >= 1; index-- )); do
    if [[ -f "$LOG_FILE.$index" ]]; then
      mv "$LOG_FILE.$index" "$LOG_FILE.$((index + 1))"
    fi
  done

  mv "$LOG_FILE" "$LOG_FILE.1"
}

prepend_log_block() {
  local block_file="$1"
  local new_log

  rotate_log_if_needed

  new_log="$(mktemp "${TMPDIR:-/tmp}/icloud-sync-demo-log.XXXXXX")"

  cat "$block_file" > "$new_log"
  if [[ -s "$LOG_FILE" ]]; then
    printf '\n' >> "$new_log"
    cat "$LOG_FILE" >> "$new_log"
  fi

  mv "$new_log" "$LOG_FILE"
}

power_source() {
  pmset -g batt | sed -n "s/^Now drawing from '\\(.*\\)'/\\1/p"
}

battery_percent() {
  pmset -g batt | awk -F '\t' '/InternalBattery/ { split($2, fields, ";"); gsub(/[^0-9]/, "", fields[1]); print fields[1]; exit }'
}

send_alert() {
  local message="$1"

  if [[ "${ICLOUD_SYNC_NOTIFY_DRY_RUN:-0}" == "1" ]]; then
    echo "$(date -Iseconds) alert dry-run: $message" >> "$LOG_FILE"
    return
  fi

  if [[ "$ALERT_MODE" == "dialog" ]]; then
    osascript - "$message" <<'APPLESCRIPT'
on run argv
  display dialog (item 1 of argv) buttons {"OK"} default button "OK" with title "iCloud Sync Demo" with icon caution
end run
APPLESCRIPT
  else
    osascript - "$message" <<'APPLESCRIPT'
on run argv
  display notification (item 1 of argv) with title "iCloud Sync Demo"
end run
APPLESCRIPT
  fi
}

if [[ "$(power_source)" == "Battery Power" ]]; then
  current_battery_percent="$(battery_percent)"
  if [[ -n "$current_battery_percent" ]] && (( current_battery_percent < MIN_BATTERY_PERCENT )); then
    battery_log="$(mktemp "${TMPDIR:-/tmp}/icloud-sync-demo-run.XXXXXX")"
    {
      echo "================================================================================"
      echo "run: skipped"
      echo "time: $(date -Iseconds)"
      echo "reason: battery below threshold"
      echo "battery: ${current_battery_percent}%"
      echo "threshold: ${MIN_BATTERY_PERCENT}%"
      echo "================================================================================"
    } > "$battery_log"
    prepend_log_block "$battery_log"
    rm -f "$battery_log"
    exit 0
  fi
fi

if ! mkdir "$LOCK_DIR" 2>/dev/null; then
  lock_log="$(mktemp "${TMPDIR:-/tmp}/icloud-sync-demo-run.XXXXXX")"
  {
    echo "================================================================================"
    echo "run: skipped"
    echo "time: $(date -Iseconds)"
    echo "reason: previous sync still running"
    echo "lock: $LOCK_DIR"
    echo "================================================================================"
  } > "$lock_log"
  prepend_log_block "$lock_log"
  rm -f "$lock_log"
  exit 0
fi

cleanup() {
  rmdir "$LOCK_DIR"
}
trap cleanup EXIT

run_log="$(mktemp "${TMPDIR:-/tmp}/icloud-sync-demo-run.XXXXXX")"
run_started_epoch="$(date +%s)"

set +e
{
  echo "================================================================================"
  echo "run: sync"
  echo "started: $(date -Iseconds)"
  echo "source: $SRC"
  echo "destination: $DST"
  echo "delete: disabled"
  echo "lock: $LOCK_DIR"
  echo "--------------------------------------------------------------------------------"
  rsync -av "$SRC" "$DST"
  rsync_status=$?
  echo "--------------------------------------------------------------------------------"
  echo "finished: $(date -Iseconds)"
  run_duration_seconds=$(( $(date +%s) - run_started_epoch ))
  echo "duration_seconds: $run_duration_seconds"
  if (( rsync_status == 0 && run_duration_seconds > MAX_RUN_SECONDS )); then
    echo "cost_warning: duration exceeded ${MAX_RUN_SECONDS}s threshold"
  fi
  echo "result: $([[ "$rsync_status" -eq 0 ]] && echo success || echo "failed with exit code $rsync_status")"
  echo "================================================================================"
} > "$run_log" 2>&1
set -e

prepend_log_block "$run_log"
rm -f "$run_log"

if (( rsync_status == 0 && run_duration_seconds > MAX_RUN_SECONDS )); then
  send_alert "Demo sync took ${run_duration_seconds}s, above ${MAX_RUN_SECONDS}s."
fi

exit "$rsync_status"
