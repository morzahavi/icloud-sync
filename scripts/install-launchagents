#!/bin/zsh

set -e
set -u
set -o pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
source "$REPO_ROOT/scripts/lib/icloud-sync-config"

LAUNCH_AGENTS_DIR="$HOME/Library/LaunchAgents"
SYNC_LABEL="dev.icloud-sync"
HEALTH_LABEL="dev.icloud-sync.health"
FIRST_INSTALL=false

install_config_file() {
  local source="$1"
  local target="$2"

  mkdir -p "$(dirname "$target")"

  if [[ -f "$target" ]]; then
    echo "kept existing $target"
    return
  fi

  cp "$source" "$target"
  FIRST_INSTALL=true
  echo "created $target"
}

install_config_file "$REPO_ROOT/config/icloud-sync.conf.example" "$CONFIG_FILE"
install_config_file "$REPO_ROOT/config/sync-pairs.conf.example" "$SYNC_PAIRS_FILE"

if ! has_sync_sources; then
  echo "No sync sources are configured yet."
  "$REPO_ROOT/scripts/configure-sync-sources"
fi

if ! has_sync_sources; then
  echo "install cancelled: choose at least one local source folder before installing automation" >&2
  exit 1
fi

if ! require_min_free_space "$HOME" "$SYNC_MIN_FREE_LOCAL_MB" "local storage"; then
  echo "install cancelled: local storage is below threshold" >&2
  exit 1
fi

if ! require_min_free_space "$SYNC_ICLOUD_ROOT" "$SYNC_MIN_FREE_ICLOUD_MB" "iCloud target storage"; then
  echo "install cancelled: iCloud target storage is below threshold" >&2
  exit 1
fi

install_agent() {
  local label="$1"
  local template="$REPO_ROOT/launchd/$label.plist"
  local target="$LAUNCH_AGENTS_DIR/$label.plist"
  local domain="gui/$(id -u)"

  mkdir -p "$LAUNCH_AGENTS_DIR"

  if launchctl print "$domain/$label" >/dev/null 2>&1; then
    launchctl bootout "$domain/$label"
  fi

  sed \
    -e "s#__REPO_ROOT__#$REPO_ROOT#g" \
    -e "s#<integer>600</integer>#<integer>$SYNC_INTERVAL_SECONDS</integer>#g" \
    "$template" > "$target"
  plutil -lint "$target" >/dev/null

  launchctl bootstrap "$domain" "$target"
  launchctl enable "$domain/$label"
  launchctl kickstart -k "$domain/$label"

  echo "installed $label"
}

install_agent "$SYNC_LABEL"
install_agent "$HEALTH_LABEL"

if [[ "$FIRST_INSTALL" == "true" ]]; then
  echo "opening status dashboard"
  "$REPO_ROOT/scripts/icloud-sync-gui"
fi
