#!/bin/zsh

set -e
set -u
set -o pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$SCRIPT_DIR/lib/icloud-sync-config"

SYNC_LABEL="dev.icloud-sync"
HEALTH_LABEL="dev.icloud-sync.health"
DOMAIN="gui/$(id -u)"
STATE_DIR="$SYNC_STATE_DIR"
LOG_DIR="$SYNC_LOG_DIR"
LAST_RUN_FILE="$STATE_DIR/sync.last-run"
LAUNCH_AGENTS_DIR="$HOME/Library/LaunchAgents"

agent_script_name() {
  case "$1" in
    "$SYNC_LABEL") echo "sync-to-icloud" ;;
    "$HEALTH_LABEL") echo "check-sync-health" ;;
  esac
}

agent_program() {
  local label="$1"
  local plist="$LAUNCH_AGENTS_DIR/$label.plist"

  [[ ! -f "$plist" ]] && return 1
  plutil -extract ProgramArguments.2 raw -o - "$plist" 2>/dev/null
}

expected_agent_program() {
  local label="$1"
  local script_name

  script_name="$(agent_script_name "$label")"
  echo "exec \"$SCRIPT_DIR/$script_name\""
}

print_agent_status() {
  local label="$1"
  local program
  local expected

  if launchctl print "$DOMAIN/$label" >/dev/null 2>&1; then
    echo "$label: loaded"
  else
    echo "$label: not loaded"
  fi

  if program="$(agent_program "$label")"; then
    expected="$(expected_agent_program "$label")"
    echo "  program: $program"
    if [[ "$program" == "$expected" ]]; then
      echo "  matches this checkout: yes"
    else
      echo "  matches this checkout: no"
      echo "  expected: $expected"
    fi
  else
    echo "  plist: missing"
  fi
}

echo "config: $CONFIG_FILE"
echo "sync pairs: $SYNC_PAIRS_FILE"
echo "iCloud root: $(normalize_dir "$SYNC_ICLOUD_ROOT")"
echo "delete destination: $SYNC_DELETE_DESTINATION"
echo "sync interval seconds: $SYNC_INTERVAL_SECONDS"
echo "stale after seconds: $SYNC_STALE_AFTER_SECONDS"
echo "filter file name: $SYNC_FILTER_FILE_NAME"
echo "local free MB: $(free_mb_for_path "$HOME")"
echo "required local free MB: $SYNC_MIN_FREE_LOCAL_MB"
echo "iCloud target free MB: $(free_mb_for_path "$SYNC_ICLOUD_ROOT")"
echo "required iCloud free MB: $SYNC_MIN_FREE_ICLOUD_MB"
echo "sync log: $LOG_DIR/sync.log"
echo "health log: $LOG_DIR/sync-health.log"
echo "mappings:"

has_mappings=false
while IFS= read -r source_dir; do
  has_mappings=true
  if reject_source_path "$source_dir" >/dev/null 2>&1; then
    echo "  $source_dir -> $(destination_for_source "$source_dir")"
    echo "    filter: $(filter_file_for_source "$source_dir")"
  else
    echo "  rejected: $source_dir"
  fi
done < <(iter_sync_sources)

if [[ "$has_mappings" == "false" ]]; then
  echo "  none configured"
fi

if [[ -f "$LAST_RUN_FILE" ]]; then
  echo "last successful sync: $(cat "$LAST_RUN_FILE")"
else
  echo "last successful sync: never"
fi

print_agent_status "$SYNC_LABEL"
print_agent_status "$HEALTH_LABEL"
